    <string name="help_content_align">Disegna una linea lungo un bordo orizzontale o verticale, quindi tocca il segno di spunta per raddrizzare l’immagine.</string>
    <string name="help_content_speech_bubble">Scegli la forma del fumetto e imposta lo spessore del contorno. Puoi spostarlo, ruotarlo e ridimensionarlo. Trascina il punto piccolo per posizionare la coda. Il segno di spunta inserisce il fumetto nell’immagine.</string>
    <string name="help_content_shadow">Crea un’ombra dal livello attivo.</string>
    <string name="help_content_warp">Usa il cursore della dimensione per impostare l’area interessata. Trascina sull’immagine per deformare i pixel all’interno del cerchio. Il cerchio appare solo durante il movimento.</string>
    <string name="help_content_filter_bilateral">Uniforma piccole irregolarità e rumore senza sfocare troppo i bordi nitidi. Usa il cursore per impostare l’intensità.</string>
    <string name="help_content_filter_invert">Inverte tutti i colori dell’immagine. Il nero diventa bianco e ogni colore cambia nel suo opposto.</string>
    <string name="help_content_filter_brightness">Rende tutte le aree dell’immagine uniformemente più chiare o più scure. Le aree luminose possono diventare bianche più rapidamente.</string>
    <string name="help_content_filter_exposure">Aumenta o riduce la luce già presente nell’immagine. Questo modifica l’immagine in modo più naturale.</string>
    <string name="help_content_filter_contrast">Aumenta o riduce la differenza tra aree chiare e scure. Usa il cursore per impostare il contrasto.</string>
    <string name="help_content_filter_blur">Ammorbidisce l’immagine e sfoca i dettagli. Usa il cursore per impostare l’intensità.</string>
    <string name="help_content_filter_bloom">Crea un bagliore morbido attorno alle aree luminose. Usa il cursore per impostare l’intensità.</string>
    <string name="help_content_filter_median">Uniforma piccole imperfezioni e rumore mantenendo i bordi il più nitidi possibile.</string>
    <string name="help_content_filter_saturation">Usa il cursore per rendere i colori più o meno intensi. Spostalo a sinistra per indebolirli fino al grigio, oppure a destra per rafforzarli.</string>
    <string name="help_content_filter_hue">Sposta tutti i colori dell’immagine nello spettro cromatico. Usa il cursore per scegliere la nuova tonalità.</string>
    <string name="help_content_filter_vibrance">Rafforza soprattutto i colori deboli senza modificare troppo quelli già vivaci. Usa il cursore per impostare l’intensità.</string>
    <string name="help_content_filter_temperature">Rende l’immagine più fredda o più calda. Sposta a sinistra per i toni blu e a destra per i toni gialli o rossi.</string>
    <string name="help_content_filter_highlights">Modifica solo le parti luminose dell’immagine. Usa il cursore per rendere le luci più chiare o più scure.</string>
    <string name="help_content_filter_shadows">Modifica solo le parti scure dell’immagine. Usa il cursore per rendere le ombre più chiare o più scure.</string>
    <string name="help_content_filter_sepia">Dona all’immagine un caldo aspetto seppia marrone. Usa il cursore per impostare l’intensità.</string>
    <string name="help_content_filter_sharpen">Rende più nitidi i bordi e i dettagli. Usa il cursore per impostare la nitidezza.</string>
    <string name="help_content_filter_vignette">Scurisce i bordi dell’immagine e richiama l’attenzione al centro. Usa il cursore per impostare l’intensità.</string>
    <string name="help_content_filter_clarity">Enfatizza le texture e il contrasto fine. Usa il cursore per impostare la chiarezza.</string>
    <string name="help_content_filter_pixel">Pixelizza l’immagine. Usa il cursore per impostare la dimensione dei pixel.</string>
