    <string name="help_content_align">Tracez une ligne le long d’un bord horizontal ou vertical, puis appuyez sur la coche pour redresser l’image.</string>
    <string name="help_content_speech_bubble">Choisissez la forme de la bulle et réglez l’épaisseur du contour. Vous pouvez la déplacer, la faire pivoter et la redimensionner. Faites glisser le petit point pour placer la queue. La coche insère la bulle dans l’image.</string>
    <string name="help_content_shadow">Crée une ombre à partir du calque actif.</string>
    <string name="help_content_warp">Utilisez le curseur de taille pour définir la zone affectée. Faites glisser sur l’image pour déformer les pixels à l’intérieur du cercle. Le cercle n’apparaît que pendant le mouvement.</string>
    <string name="help_content_filter_bilateral">Lisse les petites irrégularités et le bruit sans trop flouter les bords nets. Utilisez le curseur pour régler l’intensité.</string>
    <string name="help_content_filter_invert">Inverse toutes les couleurs de l’image. Le noir devient blanc et chaque couleur devient son opposé.</string>
    <string name="help_content_filter_brightness">Éclaircit ou assombrit uniformément toutes les zones de l’image. Les zones claires peuvent devenir blanches plus rapidement.</string>
    <string name="help_content_filter_exposure">Augmente ou réduit la lumière déjà présente dans l’image. Cela modifie l’image plus naturellement.</string>
    <string name="help_content_filter_contrast">Augmente ou réduit la différence entre les zones claires et sombres. Utilisez le curseur pour régler le contraste.</string>
    <string name="help_content_filter_blur">Adoucit l’image et floute les détails. Utilisez le curseur pour régler l’intensité.</string>
    <string name="help_content_filter_bloom">Crée une lueur douce autour des zones claires. Utilisez le curseur pour régler l’intensité.</string>
    <string name="help_content_filter_median">Lisse les petites imperfections et le bruit tout en conservant les bords aussi nets que possible.</string>
    <string name="help_content_filter_saturation">Utilisez le curseur pour rendre les couleurs plus ou moins fortes. À gauche, elles s’affaiblissent jusqu’à ce que l’image soit grise ; à droite, elles se renforcent.</string>
    <string name="help_content_filter_hue">Décale toutes les couleurs de l’image dans le spectre chromatique. Utilisez le curseur pour choisir la nouvelle teinte.</string>
    <string name="help_content_filter_vibrance">Renforce surtout les couleurs faibles sans trop modifier celles qui sont déjà vives. Utilisez le curseur pour régler l’intensité.</string>
    <string name="help_content_filter_temperature">Rend l’image plus froide ou plus chaude. Déplacez vers la gauche pour les tons bleus et vers la droite pour les tons jaunes ou rouges.</string>
    <string name="help_content_filter_highlights">Modifie uniquement les parties claires de l’image. Utilisez le curseur pour éclaircir ou assombrir les hautes lumières.</string>
    <string name="help_content_filter_shadows">Modifie uniquement les parties sombres de l’image. Utilisez le curseur pour éclaircir ou assombrir les ombres.</string>
    <string name="help_content_filter_sepia">Donne à l’image un aspect sépia brun et chaud. Utilisez le curseur pour régler l’intensité.</string>
    <string name="help_content_filter_sharpen">Rend les bords et les détails plus nets. Utilisez le curseur pour régler la netteté.</string>
    <string name="help_content_filter_vignette">Assombrit les bords de l’image et attire l’attention vers le centre. Utilisez le curseur pour régler l’intensité.</string>
    <string name="help_content_filter_clarity">Accentue les textures et le contraste fin. Utilisez le curseur pour régler la clarté.</string>
    <string name="help_content_filter_pixel">Pixellise l’image. Utilisez le curseur pour régler la taille des pixels.</string>
