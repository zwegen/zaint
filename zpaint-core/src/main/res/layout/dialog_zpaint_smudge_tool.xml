<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/zpaint_smudge_top_layout">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/zpaint_stroke_width_width_text_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="10dp"
        style="@style/TextFieldTheme">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/zpaint_stroke_width_width_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="4dp"
            android:minEms="3"
            android:saveEnabled="false"
            android:background="@drawable/zpaint_round_rect_shape"
            android:textColor="?attr/colorAccent"
            android:textStyle="bold"
            android:layoutDirection="ltr"
            tools:ignore="LabelFor"
            android:gravity="center"
            tools:text="100" />

    </com.google.android.material.textfield.TextInputLayout>

    <SeekBar
        android:id="@+id/zpaint_stroke_width_seek_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/zpaint_stroke_width_width_text_layout"
        android:layout_alignBottom="@id/zpaint_stroke_width_width_text_layout"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/zpaint_stroke_width_width_text_layout"
        android:max="100"
        android:minHeight="30dip" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/zpaint_stroke_width_seek_bar"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="14dp"
        android:translationY="-8dp"
        android:text="@string/brush_control_size"
        android:textColor="@color/zpaint_save_cancel_button"
        android:textSize="12sp" />

    </RelativeLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="50dp">
        <!--> This Linear layout is needed for the preview.
        The Brush tool searches for the Top of the parent<-->
        <de.zwegen.zpaint.ui.tools.BrushToolView
            android:id="@+id/zpaint_brush_tool_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/zpaint_smudge_bottom_layout"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/zpaint_stroke_types"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layoutDirection="ltr"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/zpaint_stroke_ibtn_circle"
                style="@style/ChipTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                app:chipIcon="@drawable/ic_zpaint_tool_circle" />

            <com.google.android.material.chip.Chip
                android:id="@+id/zpaint_stroke_ibtn_rect"
                style="@style/ChipTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_zpaint_tool_square" />

        </com.google.android.material.chip.ChipGroup>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:focusableInTouchMode="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/zpaint_smudge_tool_dialog_pressure_input_text_view"
                    style="@style/ZPaintToolSubtitle"
                    android:labelFor="@+id/zpaint_smudge_tool_dialog_pressure_input"
                    android:text="@string/smudge_tool_dialog_pressure_title" />

                <View style="@style/ZPaintToolSectionDivider" />

                <LinearLayout style="@style/ZPaintToolSection">

                    <SeekBar
                        android:id="@+id/zpaint_pressure_seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:minHeight="30dip" />

                    <Space style="@style/ZPaintToolHorizontalSpace" />

                    <EditText
                        android:id="@+id/zpaint_smudge_tool_dialog_pressure_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:minEms="3"
                        android:saveEnabled="false"
                        android:textColor="?attr/colorAccent"
                        android:textCursorDrawable="@null"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:focusableInTouchMode="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/zpaint_smudge_tool_dialog_drag_input_text_view"
                    style="@style/ZPaintToolSubtitle"
                    android:labelFor="@+id/zpaint_smudge_tool_dialog_drag_input"
                    android:text="@string/smudge_tool_dialog_drag_title" />

                <View style="@style/ZPaintToolSectionDivider" />

                <LinearLayout style="@style/ZPaintToolSection">

                    <SeekBar
                        android:id="@+id/zpaint_drag_seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:minHeight="30dip" />

                    <Space style="@style/ZPaintToolHorizontalSpace" />

                    <EditText
                        android:id="@+id/zpaint_smudge_tool_dialog_drag_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:minEms="3"
                        android:saveEnabled="false"
                        android:textColor="?attr/colorAccent"
                        android:textCursorDrawable="@null"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</RelativeLayout>
