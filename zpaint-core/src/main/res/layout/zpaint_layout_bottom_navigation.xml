<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/zpaint_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:labelVisibilityMode="labeled"
        android:background="?attr/colorPrimary"
        app:itemIconTint="@color/zpaint_bottom_navigation_item_tint"
        app:itemTextColor="@color/zpaint_bottom_navigation_item_tint"
        app:itemPaddingTop="5dp"
        app:itemPaddingBottom="8dp"
        app:menu="@menu/menu_zpaint_bottom_navigation"
        app:itemTextAppearanceActive="@style/BottomNavigationViewLabel"
        app:itemTextAppearanceInactive="@style/BottomNavigationViewLabel"/>
</RelativeLayout>
