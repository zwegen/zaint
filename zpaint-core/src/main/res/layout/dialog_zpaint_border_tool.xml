<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zpaint_border_top_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/zpaint_border_amount_input_layout"
            style="@style/TextFieldTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/zpaint_border_amount_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/zpaint_round_rect_shape"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:layoutDirection="ltr"
                android:minEms="3"
                android:padding="4dp"
                android:saveEnabled="false"
                android:textColor="?attr/colorAccent"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/zpaint_border_seek_bar_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/zpaint_border_amount_input_layout"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@id/zpaint_border_amount_input_layout"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/zpaint_border_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="30dip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:translationY="-8dp"
                android:text="@string/slider_label_border"
                android:textColor="@color/zpaint_save_cancel_button"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/zpaint_border_zero_marker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/zpaint_zero_marker"
                android:textColor="?attr/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
</RelativeLayout>
