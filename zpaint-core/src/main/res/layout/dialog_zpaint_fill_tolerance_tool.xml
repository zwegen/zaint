<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/zpaint_fill_tolerance_input_layout"
        style="@style/TextFieldTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/zpaint_fill_tool_dialog_color_tolerance_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/zpaint_round_rect_shape"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:layoutDirection="ltr"
            android:minEms="3"
            android:padding="4dp"
            android:saveEnabled="false"
            android:textColor="?attr/colorAccent"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <SeekBar
        android:id="@+id/zpaint_color_tolerance_seek_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:max="100"
        android:minHeight="30dip"
        app:layout_constraintBottom_toBottomOf="@id/zpaint_fill_tolerance_input_layout"
        app:layout_constraintEnd_toStartOf="@id/zpaint_fill_antialiasing_label"
        app:layout_constraintStart_toEndOf="@id/zpaint_fill_tolerance_input_layout"
        app:layout_constraintTop_toTopOf="@id/zpaint_fill_tolerance_input_layout" />

    <TextView
        android:id="@+id/zpaint_fill_tolerance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/slider_label_tolerance"
        android:textColor="@color/zpaint_save_cancel_button"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/zpaint_fill_antialiasing_label"
        app:layout_constraintEnd_toEndOf="@id/zpaint_color_tolerance_seek_bar" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/zpaint_fill_antialiasing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:contentDescription="@string/fill_tool_antialiasing"
        app:layout_constraintBottom_toBottomOf="@id/zpaint_fill_tolerance_input_layout"
        app:layout_constraintEnd_toEndOf="@id/zpaint_fill_antialiasing_label"
        app:layout_constraintStart_toStartOf="@id/zpaint_fill_antialiasing_label"
        app:layout_constraintTop_toTopOf="@id/zpaint_fill_tolerance_input_layout" />

    <TextView
        android:id="@+id/zpaint_fill_antialiasing_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:labelFor="@id/zpaint_fill_antialiasing"
        android:text="@string/fill_tool_antialiasing"
        android:textColor="@color/zpaint_save_cancel_button"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zpaint_fill_antialiasing" />
</androidx.constraintlayout.widget.ConstraintLayout>
