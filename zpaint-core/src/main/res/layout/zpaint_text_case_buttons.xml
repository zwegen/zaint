<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/zpaint_text_input_format_controls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <LinearLayout
        android:id="@+id/zpaint_text_input_format_controls_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UselessParent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_text_case_uppercase"
                style="@style/ZaintSquareIconButtonGroupStartStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/text_tool_dialog_case_uppercase"
                android:gravity="center"
                app:icon="@drawable/ic_zpaint_text_case_uppercase"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_text_case_lowercase"
                style="@style/ZaintSquareIconButtonGroupMiddleStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-1dp"
                android:contentDescription="@string/text_tool_dialog_case_lowercase"
                android:gravity="center"
                app:icon="@drawable/ic_zpaint_text_case_lowercase"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_text_case_title"
                style="@style/ZaintSquareIconButtonGroupEndStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-1dp"
                android:contentDescription="@string/text_tool_dialog_case_title"
                android:gravity="center"
                app:icon="@drawable/ic_zpaint_text_letter_case"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/zpaint_text_input_alignment_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_text_input_align_left"
                style="@style/ZaintSquareIconButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/text_tool_dialog_align_left"
                app:icon="@drawable/ic_zpaint_text_align_left"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_text_input_align_center"
                style="@style/ZaintSquareIconButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/text_tool_dialog_align_center"
                app:icon="@drawable/ic_zpaint_text_align_center"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_text_input_align_right"
                style="@style/ZaintSquareIconButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/text_tool_dialog_align_right"
                app:icon="@drawable/ic_zpaint_text_align_right"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_text_input_align_justify"
                style="@style/ZaintSquareIconButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/text_tool_dialog_align_justify"
                app:icon="@drawable/ic_zpaint_text_align_justify"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</LinearLayout>
