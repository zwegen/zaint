<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ZaintDialogSurface"
    android:orientation="vertical">

    <TextView
        style="@style/ZaintDialogTitle"
        android:id="@+id/zaint_overwrite_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:background="@color/zpaint_colorPrimarySelected" />

    <TextView
        android:id="@+id/zaint_overwrite_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            style="@style/ZaintDialogAction.Secondary"
            android:id="@+id/zaint_overwrite_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            style="@style/ZaintDialogAction.Primary"
            android:id="@+id/zaint_overwrite_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
