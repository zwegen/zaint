<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:ignore="RelativeOverlap">

    <RelativeLayout
        android:id="@+id/zpaint_layout_selection_tool_options"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/selection_shape_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            app:checkedButton="@id/action_shape_rectangle"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_shape_rectangle"
                style="@style/SelectionToolSquareButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:checkable="true"
                android:contentDescription="@string/selection_tool_shape_rectangle"
                app:icon="@drawable/ic_zpaint_rectangle_out"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_shape_circle"
                style="@style/SelectionToolSquareButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:checkable="true"
                android:contentDescription="@string/selection_tool_shape_circle"
                app:icon="@drawable/ic_zpaint_circle_out"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_shape_free"
                style="@style/SelectionToolSquareButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:checkable="true"
                android:contentDescription="@string/selection_tool_shape_free"
                app:icon="@drawable/ic_zpaint_selection_lasso"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/selection_action_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_copy"
                style="@style/SelectionToolSquareButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/clipboard_tool_copy"
                app:icon="@drawable/ic_zpaint_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_cut"
                style="@style/SelectionToolSquareButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/clipboard_tool_cut"
                app:icon="@drawable/ic_zpaint_cut"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_delete"
                style="@style/SelectionToolSquareButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/selection_tool_delete"
                app:icon="@drawable/ic_zpaint_layers_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </RelativeLayout>

</RelativeLayout>
