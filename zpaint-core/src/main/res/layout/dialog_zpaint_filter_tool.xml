<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/zpaint_filter_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/zpaint_filter_value_input_layout"
            style="@style/TextFieldTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/zpaint_filter_value_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/zpaint_round_rect_shape"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberSigned"
                android:layoutDirection="ltr"
                android:minEms="3"
                android:padding="4dp"
                android:saveEnabled="false"
                android:textColor="?attr/colorAccent"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/zpaint_filter_seek_bar_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/zpaint_filter_value_input_layout"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/zpaint_filter_value_input_layout"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/zpaint_filter_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="30dip" />

            <TextView
                android:id="@+id/zpaint_filter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:translationY="-8dp"
                android:textColor="@color/zpaint_save_cancel_button"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/zpaint_filter_zero_marker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/zpaint_zero_marker"
                android:textColor="?attr/colorAccent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/zpaint_filter_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/zpaint_splash_color_palette"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/zpaint_splash_color_0"
                style="?actionButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-1dp"
                android:background="@drawable/zpaint_gradient_color_swatch"
                android:contentDescription="@string/help_content_color_chooser" />

            <ImageButton
                android:id="@+id/zpaint_splash_color_1"
                style="?actionButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-1dp"
                android:background="@drawable/zpaint_gradient_color_swatch"
                android:contentDescription="@string/help_content_color_chooser" />

            <ImageButton
                android:id="@+id/zpaint_splash_color_2"
                style="?actionButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-1dp"
                android:background="@drawable/zpaint_gradient_color_swatch"
                android:contentDescription="@string/help_content_color_chooser" />

            <ImageButton
                android:id="@+id/zpaint_splash_color_3"
                style="?actionButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-1dp"
                android:background="@drawable/zpaint_gradient_color_swatch"
                android:contentDescription="@string/help_content_color_chooser" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/zpaint_filter_area_mode_toggle_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:selectionRequired="true"
            app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zpaint_filter_mode_whole_image"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/transform_scope_background_color"
            android:text="@string/pixel_tool_dialog_mode_whole_image"
            android:textAllCaps="false"
            android:textColor="@color/transform_scope_text_color"
            android:textSize="12sp"
            app:strokeColor="@color/transform_scope_stroke_color"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zpaint_filter_mode_area"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/transform_scope_background_color"
            android:text="@string/pixel_tool_dialog_mode_area"
            android:textAllCaps="false"
            android:textColor="@color/transform_scope_text_color"
            android:textSize="12sp"
            app:strokeColor="@color/transform_scope_stroke_color"
            app:strokeWidth="1dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:id="@+id/zpaint_filter_area_mode_bottom_spacer"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
