<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/zpaint_transform_resize_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/zpaint_transform_resize_percentage_input_layout"
            style="@style/TextFieldTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/zpaint_transform_resize_percentage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/zpaint_round_rect_shape"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:layoutDirection="ltr"
                android:minEms="3"
                android:padding="4dp"
                android:saveEnabled="false"
                android:textColor="?attr/colorAccent"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="100" />
        </com.google.android.material.textfield.TextInputLayout>

        <SeekBar
            android:id="@+id/zpaint_transform_resize_seekbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/zpaint_transform_resize_percentage_input_layout"
            android:layout_alignBottom="@id/zpaint_transform_resize_percentage_input_layout"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@id/zpaint_transform_resize_percentage_input_layout"
            android:max="100"
            android:minHeight="30dip"
            android:progress="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/zpaint_transform_resize_seekbar"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="14dp"
            android:translationY="-8dp"
            android:text="@string/slider_label_scale"
            android:textColor="@color/zpaint_save_cancel_button"
            android:textSize="12sp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:background="@android:color/white"
            android:orientation="vertical">

        <TextView
            style="@style/ZPaintToolSubtitle"
            android:textColor="@color/zpaint_colorAccent"
            android:text="@string/transform_tool_auto_crop_text" />

        <View style="@style/ZPaintToolSectionDivider"/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/zpaint_transform_ratio_toggle_group"
            style="@style/ZPaintToolSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_transform_ratio_free"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:backgroundTint="@color/transform_scope_background_color"
                android:text="@string/transform_ratio_free"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="@color/transform_scope_text_color"
                android:textSize="12sp"
                app:strokeColor="@color/transform_scope_stroke_color"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_transform_ratio_square"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:backgroundTint="@color/transform_scope_background_color"
                android:text="@string/transform_ratio_square"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="@color/transform_scope_text_color"
                android:textSize="12sp"
                app:strokeColor="@color/transform_scope_stroke_color"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_transform_ratio_four_five"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:backgroundTint="@color/transform_scope_background_color"
                android:text="@string/transform_ratio_four_five"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="@color/transform_scope_text_color"
                android:textSize="12sp"
                app:strokeColor="@color/transform_scope_stroke_color"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zpaint_transform_ratio_sixteen_nine"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:backgroundTint="@color/transform_scope_background_color"
                android:text="@string/transform_ratio_sixteen_nine"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="@color/transform_scope_text_color"
                android:textSize="12sp"
                app:strokeColor="@color/transform_scope_stroke_color"
                app:strokeWidth="1dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            style="@style/ZPaintToolSection"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/zpaint_transform_dimension_input_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/zpaint_transform_width_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:labelFor="@+id/zpaint_transform_width_value"
                    android:paddingStart="12dp"
                    android:text="@string/transform_width_text"
                    android:textColor="#B8B8B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/zpaint_transform_width_value"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical|end"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="number"
                    android:paddingEnd="12dp"
                    android:textAlignment="viewEnd"
                    android:textColor="?attr/colorAccent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="100" />
            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/zpaint_transform_dimension_input_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/zpaint_transform_height_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:labelFor="@+id/zpaint_transform_height_value"
                    android:paddingStart="12dp"
                    android:text="@string/transform_height_text"
                    android:textColor="#B8B8B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/zpaint_transform_height_value"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical|end"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="number"
                    android:paddingEnd="12dp"
                    android:textAlignment="viewEnd"
                    android:textColor="?attr/colorAccent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="100" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
