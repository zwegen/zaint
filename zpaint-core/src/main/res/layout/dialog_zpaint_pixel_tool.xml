<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/zpaint_pixel_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/zpaint_pixel_size_value_input_layout"
            style="@style/TextFieldTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/zpaint_pixel_size_value_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/zpaint_round_rect_shape"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:layoutDirection="ltr"
                android:minEms="3"
                android:padding="4dp"
                android:saveEnabled="false"
                android:textColor="?attr/colorAccent"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <SeekBar
            android:id="@+id/zpaint_pixel_size_seek_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/zpaint_pixel_size_value_input_layout"
            android:layout_alignBottom="@id/zpaint_pixel_size_value_input_layout"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:layout_toEndOf="@+id/zpaint_pixel_size_value_input_layout"
            android:minHeight="30dip" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/zpaint_pixel_size_seek_bar"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="14dp"
            android:translationY="-8dp"
            android:text="@string/pixel_tool_dialog_size_title"
            android:textColor="@color/zpaint_save_cancel_button"
            android:textSize="12sp" />
    </RelativeLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/zpaint_pixel_mode_toggle_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zpaint_pixel_mode_whole_image"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:backgroundTint="@color/transform_scope_background_color"
            android:text="@string/pixel_tool_dialog_mode_whole_image"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/transform_scope_text_color"
            android:textSize="12sp"
            app:strokeColor="@color/transform_scope_stroke_color"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zpaint_pixel_mode_area"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:backgroundTint="@color/transform_scope_background_color"
            android:text="@string/pixel_tool_dialog_mode_area"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/transform_scope_text_color"
            android:textSize="12sp"
            app:strokeColor="@color/transform_scope_stroke_color"
            app:strokeWidth="1dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</RelativeLayout>
